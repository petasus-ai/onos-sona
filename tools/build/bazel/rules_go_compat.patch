-    "sets",
-)
-load(
     "@io_bazel_rules_go//go/private:common.bzl",
     "as_tuple",
     "split_srcs",
@@ -230,3 +226,11 @@
         runfiles = runfiles,
         mode = go.mode,
     )
+
+# bazel-skylib 1.0 removed lib/old_sets.bzl, which this version of rules_go
+# loaded for its depset-based set helpers. Only sets.union() is used here, so
+# ONOS patches in a local equivalent instead of pinning an older skylib.
+def _old_sets_union(*args):
+    return depset(transitive = [x if type(x) == "depset" else depset(x) for x in args])
+
+sets = struct(union = _old_sets_union)
