         return depset(v)
     fail("as_tuple failed on {}".format(v))
+
+# Newer rules_go releases export the Go toolchain type from this module, and
+# tooling that inspects a workspace (the IntelliJ Bazel plugin's generated
+# aspects in .bazelbsp/modules/go_info.bzl, for one) loads it unconditionally.
+# ONOS adds it here so that tooling can load against this pinned release.
+GO_TOOLCHAIN = "@io_bazel_rules_go//go:toolchain"
+
+GO_TOOLCHAIN_LABEL = Label(GO_TOOLCHAIN)
