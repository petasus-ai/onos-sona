# By default, we build and run ONOS using the Bazel-provided remote JDK. The
# specific JDK version is defined in tools/build/jdk/BUILD.
#
# If you prefer to use your locally installed JDK use local_java_repositoy
# in the WORKSPACE file.
#
# https://bazel.build/docs/bazel-and-java

# ONOS external dependencies are declared in WORKSPACE (not bzlmod/MODULE.bazel).
# Bazel 7 enables bzlmod by default, so explicitly stay on the WORKSPACE path.
common --noenable_bzlmod

# Builds using remotejdk_11, executes using remotejdk_11 or local_jdk
build --java_language_version=11
build --java_runtime_version=remotejdk_11
build --tool_java_language_version=11
build --tool_java_runtime_version=remotejdk_11

# Bazel 7's default Java toolchain runs JavaBuilder on the bundled JDK 21, which
# breaks this JDK 11 codebase (rejects "-source 7", and writes jars the stricter
# zip validation later rejects in the OSGi wrapper). Use a toolchain that runs
# JavaBuilder on JDK 11 instead. --extra_toolchains gives it highest priority so
# it is selected for both target (--java_language_version=11) and tool/exec
# (--tool_java_language_version=11) compilation. See tools/build/jdk/BUILD.
build --extra_toolchains=//tools/build/jdk:onos_jdk11_toolchain_definition

build --host_force_python=PY3

build --nouse_ijars
build --experimental_strict_action_env

# Bazel 7 bundles a much newer JavaBuilder/ErrorProne than the toolchain this
# codebase was written against. Many checks that were absent (or mere warnings)
# are now errors by default (BoxedPrimitiveEquality, DoubleBraceInitialization,
# DereferenceWithNullBranch, NoCanIgnoreReturnValueOnClasses, etc.), which fails
# the build across the tree. Disable all ErrorProne checks to restore the
# previous build behavior; ErrorProne is static analysis only and does not
# affect the generated bytecode.
# For external/io_grpc_grpc_java/core/src/main/java/io/grpc/internal/RetriableStream.java
build --javacopt="-XepDisableAllChecks -Xep:GuardedBy:WARN -Xep:ComparableType:WARN -Xep:ReturnValueIgnored:OFF"

# intellij-bazel plugin needs this
build --incompatible_new_actions_api=false
build --incompatible_generated_protos_in_virtual_imports=false

# For bazelbuild/rules_nodejs
build --define=angular_ivy_enabled=True

test --test_summary=terse
test --test_output=errors
test --test_verbose_timeout_warnings

# build --disk_cache=~/bazel-cache
# build --remote_http_cache=http://10.1.10.224:80/cache
